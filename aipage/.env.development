# dashboard 站点地址（aipage 独立访问且未登录时跳转到该地址的登录页）
VITE_APP_DASHBOARD_URL = http://localhost:9090

# aipage 后端接口地址（跨域访问时后端需开启 CORS，允许 aipage 的 origin 与 token 请求头）
# 不配置时默认使用当前站点 hostname
# VITE_APP_IC_HOST = 10.89.33.97
# VITE_APP_IC_PORT = 39100

# RAGFlow 知识图谱接口配置
# VITE_APP_RAGFLOW_HOST 为开发态 vite 代理目标（见 vite.config.ts 的 /ragflow-api）；
# 生产部署时 nginx 需将同源路径 /ragflow-api/ 代理到该地址（前端始终同源请求，规避 CORS）
VITE_APP_RAGFLOW_HOST = http://10.89.34.200:8888
VITE_APP_RAGFLOW_DATASET_ID = 5a6cf6aa8b1e11f1b5fe9699a389e6ed
